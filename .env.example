# ============================================================
# 合同审批审查系统 — 环境变量模板
#
# 用法：复制为 .env 后填入真实值
#   cp .env.example .env
# 本文件可安全提交到版本库，**不要**把真实密钥写在这里
# ============================================================

# ====================
# 应用基础配置
# ====================
# 数据库连接串（演示用 SQLite；生产切 MySQL 8 / PostgreSQL 15）
#   生产示例：mysql+pymysql://user:pass@127.0.0.1:3306/contract_approval
#   生产示例：postgresql+psycopg://user:pass@127.0.0.1:5432/contract_approval
DATABASE_URL=sqlite:///./data/app.db
# 合同文件落盘根目录
FILE_STORE_DIR=./data/files
# 服务监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=8000
# 调试模式（FastAPI debug）
APP_DEBUG=true
# 允许的前端来源（逗号分隔；生产务必收敛为具体域名）
APP_CORS_ORIGINS=*
# 上传文件大小上限（MB，SPEC 12 默认 50）
MAX_FILE_SIZE_MB=50

# ====================
# 鉴权配置（JWT，SPEC 12 RBAC 三角色）
# ====================
# 关闭后以 DEMO_USERNAME 身份直接放行（仅限演示联调）
AUTH_ENABLED=true
DEMO_USERNAME=admin
# 访问令牌有效期（分钟）
ACCESS_TOKEN_MINUTES=120
# 刷新令牌有效期（天）
REFRESH_TOKEN_DAYS=7
# JWT 签名密钥（>=32 随机字符；不配置则用演示密钥并在启动时告警）
APP_SECRET_KEY=

# ====================
# 数据库
# ====================
# 打印 SQL 日志（调试用）
DATABASE_ECHO=false

# ====================
# LLM 配置（OpenAI 兼容接口）
# ====================
# API 基础地址（国内可直连端点示例）
#   DeepSeek：https://api.deepseek.com
#   通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱：https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com
# API 密钥
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型名称
LLM_MODEL=deepseek-chat
# 采样温度（越低越稳定，合同审查建议 0.1 ~ 0.3）
LLM_TEMPERATURE=0.2
# 单次调用超时（秒）
LLM_TIMEOUT=60
# 单次调用失败后的重试次数（指数退避 1s / 4s）
LLM_MAX_RETRIES=2
# 未配置 LLM 时是否降级为 mock 结果
#   true  = 链路可照常跑通，但产出的是占位结果，不可用于真实审查
#   false = 直接进入 blocked，绝不产出假数据
LLM_ALLOW_MOCK=true

# ====================
# OCR 配置（PaddleOCR）
# ====================
# 运行设备：cpu / gpu
OCR_DEVICE=cpu
# 识别语言
OCR_LANG=ch
# 未安装 PaddleOCR 时是否降级为 mock 结果（false=直接进入 blocked）
OCR_ALLOW_MOCK=true
# 解析层 LLM 辅助（P1 条款分类 / P2 元数据归一化，SPEC 8.2）
PARSE_ENABLE_LLM_ASSIST=true
PARSE_LLM_MIN_CONFIDENCE=0.6
PARSE_LLM_TIMEOUT=30

# ====================
# 审查引擎配置（② review_processor）
# ====================
# 按条款并发调用 LLM 的上限
REVIEW_LLM_CONCURRENCY=4
# 同一任务 LLM 连续失败达到该次数 → 触发 REVIEW_FAIL 进 blocked
REVIEW_LLM_FAIL_THRESHOLD=3
# 是否启用 LLM 语义审查（false = 只跑规则层，用于压测/回归）
REVIEW_ENABLE_LLM=true
# 是否只审查「未被规则命中」的条款（true 省 token；false 全覆盖）
REVIEW_LLM_ONLY_UNMATCHED=true
# 单次送 LLM 的条款正文上限（超出按段落二次切分）
REVIEW_LLM_MAX_CLAUSE_CHARS=3000
# LLM 整体失败时是否把任务置为 blocked
REVIEW_BLOCK_ON_LLM_FAILURE=true

# ====================
# 推荐引擎配置（③ recommend_processor）
# ====================
# 模板召回候选数上限
RECOMMEND_TEMPLATE_TOP_K=3
# 合同类型精确匹配的候选加分（通配模板不加）
RECOMMEND_TEMPLATE_TYPE_BONUS=100
# 只为不低于该等级的风险点生成建议：low（全部）/ mid / high
RECOMMEND_MIN_RISK_LEVEL=low
# 是否启用 LLM 个性化改写（false = 纯模板模式，零 LLM 成本）
RECOMMEND_ENABLE_LLM=true
# 按条款并发调用 LLM 的上限
RECOMMEND_LLM_CONCURRENCY=4
# 连续失败达到该次数 → 整体降级为模板模式
RECOMMEND_LLM_FAIL_THRESHOLD=3
# 单次送 LLM 的条款正文上限（超出截断，改写不做分段）
RECOMMEND_LLM_MAX_CLAUSE_CHARS=3000
# 建议条款长度上限（超出截断）
RECOMMEND_MAX_SUGGESTION_CHARS=2000
# 差异对比的 LCS 单元格上限（超出退化为整体替换，防止卡死）
RECOMMEND_DIFF_MAX_CELLS=40000

# ====================
# 回写与报告（④ writeback_processor）
# ====================
# 审批系统 API 基础地址
#   演示阶段指向本地 mock 服务（启动方式见 mock_approve_service/main.py 文件头）：
#     python -m uvicorn mock_approve_service.main:app --host 127.0.0.1 --port 9000
#   接入真实审批系统时替换为对方地址即可，其余代码无需改动
APPROVE_API_BASE=http://127.0.0.1:9000/mock-approve
# 审批系统访问令牌（需与 MOCK_APPROVE_TOKEN 一致）
APPROVE_TOKEN=your-approve-token
# 回写接口超时（秒，SPEC 4.5）
APPROVE_TIMEOUT=30
# 单次失败后的自动重试次数（SPEC 4.5：默认 2 → 共 3 次尝试）
WRITEBACK_MAX_RETRY=2
# 退避秒数序列（SPEC 4.5：5s / 30s）
WRITEBACK_RETRY_BACKOFF=5,30
# 未配置审批地址时是否降级为 mock Adapter
#   true  = 链路可跑通，但评论只写进日志，**不会真正送达**（评论正文里会明确提示）
#   false = 直接报错，绝不假装送达成功
WRITEBACK_ALLOW_MOCK_ADAPTER=true
# 是否强制要求审批单号（false = 允许占位单号，仅演示用）
WRITEBACK_REQUIRE_DOC_ID=true
# 评论风险明细最多列多少条
WRITEBACK_COMMENT_MAX_RISKS=50
# 「重点关注事项」条数
WRITEBACK_HIGHLIGHT_TOP_N=3
# 评论风险明细是否包含低风险
WRITEBACK_INCLUDE_LOW=true
# 报告落盘目录
REPORT_STORE_DIR=./data/reports
# 报告 PDF 中文字体（reportlab 内置 CID 字体，无需外部字体文件）
REPORT_FONT=STSong-Light
REPORT_TITLE=合同审查报告
# 是否保留历史导出记录（false = 每次导出前清掉该任务的历史记录）
REPORT_KEEP_HISTORY=true

# ====================
# mock 审批服务自身（仅本地 mock 用）
# ====================
# 设置后 mock 服务才校验 Bearer 令牌；与 APPROVE_TOKEN 保持一致
MOCK_APPROVE_TOKEN=mock-token
