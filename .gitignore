# ==================== 密钥与本地配置 ====================
.env
.env.*
!.env.example

# ==================== Python 字节码 / 打包产物 ====================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
MANIFEST

# ==================== 虚拟环境 ====================
.venv/
venv/
env/
ENV/
.uv/

# ==================== 测试 / 类型 / 格式化工具缓存 ====================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ==================== IDE / 编辑器 ====================
.idea/
.vscode/
*.swp
*.swo
*~

# ==================== 操作系统 ====================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ==================== 运行时数据（务必忽略） ====================
# SQLite 数据库、上传文件、生成报告等，随每次运行变化，绝不入库
data/

# ==================== 日志 ====================
logs/
*.log
*.log.*

# ==================== 前端依赖与构建 ====================
node_modules/
dist-ssr/
.vite/
.eslintcache

# ==================== 备份 / 临时文件 ====================
*.bak
*.bak[0-9]
.git.backup-*
*.tmp

# ==================== WorkBuddy 及其他 agent 会话产物 ====================
# 可能含密钥与口令，绝不提交
.workbuddy/

# ==================== 根目录临时排查产物 ====================
/_*.py
/_*.txt
!/__init__.py
